# Terrain settings for an EDDIE deployment (.env). Defaults in brackets; see terrain_s2/settings.py.
# Backend: raster (LINZ 1 m DEM, no GeoFabrics) | geofabrics (point clouds). The default is decided in W7. [raster]
TERRAIN_BACKEND=raster
# Integer metres: 1, 2, 4 or 8 [8]
TERRAIN_RESOLUTION=8
# dem | geofabric (adds roughness zo; needs geofabrics) [dem]
TERRAIN_PRODUCT=dem
# coverage | topo50 | topo50_mangrove | file [coverage]
TERRAIN_LAND_SOURCE=coverage
# LAS classes to grid (TR-9 deferred) [2]
TERRAIN_LIDAR_CLASSES=2
# AOI buffer in metres; 200 when the DEM feeds Stage 2 [10]
TERRAIN_BUFFER_M=10
# Reuse a stored product that contains the AOI: FReDT true, Smart Ideas false [false]
TERRAIN_SPATIAL_REUSE=true
# Fall back to the other backend when no data are found [false]
TERRAIN_ALLOW_FALLBACK=false
# AOI from EDDIE's WKT: bbox (as eddie.tasks.wkt_to_gdf) | polygon [bbox]
TERRAIN_AOI_MODE=bbox
# GeoFabrics dask settings, per task [4GiB, 2]
TERRAIN_GF_MEMORY_LIMIT=8GiB
TERRAIN_GF_CORES=2
# Worker processes (each task may use TERRAIN_GF_CORES dask workers) [1]
TERRAIN_WORKER_CONCURRENCY=1
# Polygon file for TERRAIN_LAND_SOURCE=file
LAND_FILE=
# Compose overlay: path of the terrain-s2 checkout, the core tag the worker image installs
TERRAIN_S2_DIR=lib/terrain-s2
EDDIE_REF=v4.0.0
